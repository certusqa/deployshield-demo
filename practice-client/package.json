{
  "name": "deployshield-practice-client",
  "version": "1.0.0",
  "engines": {
    "node": ">=18 <=22"
  },
  "description": "Practice client repo — DeployShield Suite delivery demo",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "alert:payload": "node scripts/build-alert-payload.js",
    "test:gate": "playwright test; node scripts/build-alert-payload.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
